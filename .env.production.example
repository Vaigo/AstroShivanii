# ── Production build env (copy to .env.production before `npm run build`) ────
#
# 1. API base: the live GrahaAPI.
NEXT_PUBLIC_API_BASE_URL=https://api.grahaapi.com

# 2. Internal API key — REQUIRED for real (non-sample) results.
#    sk-test- keys replay a fixed sample chart, so production MUST use the
#    dedicated internal key. Create it once via the GrahaAPI admin:
#
#      curl -X POST https://api.grahaapi.com/v1/admin/keys/create \
#        -H "X-Admin-Key: <PROD_ADMIN_KEY>" \
#        -H "Content-Type: application/json" \
#        -d '{"plan": "enterprise", "email": "internal@grahaapi.com", "label": "AstroShivanii website"}'
#
#    ⚠ This site is a static export — the key ships in the public JS bundle.
#    Treat it as rotatable: it exists ONLY for this site, is monitored via the
#    GrahaAPI admin panel, and must never be reused anywhere else. Rotate it
#    (create new + delete old) if abuse is ever observed.
NEXT_PUBLIC_API_KEY=sk-prod-REPLACE_WITH_INTERNAL_KEY

# 3. Razorpay public key id (public by design; the secret lives only on the backend).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_REPLACE_ME

NEXT_PUBLIC_SITE_URL=https://astroshivanii.com

# ── Server-side prerequisite (NOT an env var of this site) ───────────────────
# GrahaAPI's ALLOWED_ORIGINS env (Railway service) must include:
#   https://astroshivanii.com,https://www.astroshivanii.com
# Without this the browser blocks every API call from the site (CORS).
# The repo default in backend/app/config.py now includes these, but the
# deployed service overrides via its own env var — update it there too.
